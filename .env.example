# ==============================================================================
# clawshell .env — copy to .env and fill in. NEVER commit the real .env.
# install.sh refuses to run if required values still match this example file.
# ==============================================================================

# ---- Host / firewall -----------------------------------------------------
SSH_PORT=22
# CIDR allowed to reach SSH. Leave as 0.0.0.0/0 to allow from anywhere (key-only
# auth is still required) or tighten to your LAN, e.g. 192.168.1.0/24.
SSH_ALLOW_CIDR=0.0.0.0/0
# CIDR allowed to reach the OpenClaw Control UI / Gateway port. Set this to your
# actual LAN subnet, not 0.0.0.0/0.
LAN_ALLOW_CIDR=192.168.1.0/24

# ---- OpenClaw Gateway ------------------------------------------------------
# Pin a specific released version — do not use a floating tag on an always-on box.
OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:2026.9.4
OPENCLAW_GATEWAY_PORT=18789
# Leave blank to auto-generate via `openssl rand -hex 32` during install.
OPENCLAW_GATEWAY_TOKEN=

# ---- Model provider (see docs/credentials.md before choosing) -------------
# One of: local-gpu | github-copilot | anthropic | openai | custom
#
# local-gpu (default): run inference ON THIS BOX on the GPU. Default backend is
# NVIDIA/vLLM (built and tuned for an RTX 6000 Ada 96 GB); set
# LOCAL_LLM_BACKEND=amd-rocm below for an AMD Radeon card (Ollama/ROCm). The
# model is served entirely on-box, so the target code,
# requirement spec, and findings never leave the machine to a third-party
# provider. No API key, no model-provider egress. The NVIDIA backend needs the
# NVIDIA Container Toolkit (install.sh installs it); the AMD backend needs only
# ROCm device access. See docs/gpu.md and docs/credentials.md. The hosted
# providers below all still work ("run on any AI provider"); switch
# MODEL_PROVIDER to use one instead.
MODEL_PROVIDER=local-gpu

# ---- Local GPU inference (only used when MODEL_PROVIDER=local-gpu) ---------
# GPU vendor / inference engine:
#   nvidia   (default) — NVIDIA GPU via vLLM (built/tuned for an RTX 6000 Ada
#             96 GB). Uses LOCAL_LLM_IMAGE/MODEL/BASE_URL and the vLLM knobs
#             below. install.sh installs the NVIDIA Container Toolkit.
#   amd-rocm — AMD Radeon GPU (e.g. RX 7900 XTX) via the Ollama ROCm build.
#             No NVIDIA toolkit; GPU is passed through as /dev/kfd + /dev/dri.
#             In this mode set LOCAL_LLM_MODEL to an OLLAMA TAG (not an HF id),
#             e.g. qwen2.5-coder:14b, and select it with
#             `openclaw models set ollama/<tag>`. The vLLM-only knobs
#             (IMAGE/SERVED_NAME/BASE_URL/MAX_MODEL_LEN/GPU_MEM_UTIL) are
#             ignored. See docs/gpu.md for VRAM-appropriate tags (24 GB cards).
LOCAL_LLM_BACKEND=nvidia
# Image serving the OpenAI-compatible API on the GPU (NVIDIA/vLLM backend).
LOCAL_LLM_IMAGE=vllm/vllm-openai:v0.30.0
# Image for the AMD/ROCm backend (Ollama). Only used when
# LOCAL_LLM_BACKEND=amd-rocm.
LOCAL_LLM_AMD_IMAGE=ollama/ollama:rocm
# NVIDIA: Hugging Face model id (or a path under state/local-llm); default fits
# well within 96 GB VRAM at full precision.
# AMD/ROCm: an Ollama model TAG instead, e.g. qwen2.5-coder:14b (comfortable on
# a 24 GB card), :32b (tight, Q4), or :7b (fast fallback).
LOCAL_LLM_MODEL=Qwen/Qwen2.5-Coder-32B-Instruct
# Only some AMD cards need an LLVM-target override; the RX 7900 XTX (gfx1100)
# is natively supported, so leave blank. If Ollama reports "no compatible
# GPUs", try e.g. 11.0.0. (amd-rocm backend only.)
HSA_OVERRIDE_GFX_VERSION=
# Name OpenClaw/clients address the model by (NVIDIA/vLLM "served" model id).
LOCAL_LLM_SERVED_NAME=clawshell-local
# Internal URL the Gateway reaches the model server at (NVIDIA/vLLM, OpenAI-
# compatible). The AMD/ROCm backend uses the native Ollama provider at
# http://local-llm-amd:11434 (no /v1) instead — see openclaw.json5.example.
LOCAL_LLM_BASE_URL=http://local-llm:8000/v1
# Serving knobs for the RTX 6000 Ada (96 GB), NVIDIA/vLLM backend only. Raise
# max-model-len for bigger codebases/specs if VRAM allows.
LOCAL_LLM_MAX_MODEL_LEN=32768
LOCAL_LLM_GPU_MEM_UTIL=0.92
# Optional — only needed for gated/private HF models. Leave blank otherwise.
HUGGING_FACE_HUB_TOKEN=
# Set to 1 once weights are cached in state/local-llm to forbid any runtime
# download (fully air-gapped inference).
HF_HUB_OFFLINE=0

# Only used when MODEL_PROVIDER=github-copilot: uses OpenClaw's built-in
# GitHub Copilot provider and your existing Copilot subscription — no separate
# API key. Auth via a one-time device-login step after install (install.sh
# prints the command), OR by setting COPILOT_GITHUB_TOKEN below for a fully
# headless setup.
#
# Only used when MODEL_PROVIDER=anthropic | openai | custom.
# REPLACE_ME is the literal placeholder install.sh checks for and refuses on
# (only enforced when MODEL_PROVIDER is anthropic/openai/custom — local-gpu
# and github-copilot do not need it).
MODEL_PROVIDER_API_KEY=REPLACE_ME
# Only used when MODEL_PROVIDER=custom (e.g. an OpenAI-compatible endpoint).
MODEL_PROVIDER_BASE_URL=

# Only used when MODEL_PROVIDER=github-copilot AND you want headless/
# non-interactive auth (no TTY device-login step). Optional — leave blank to
# do the one-time interactive device login instead. See docs/credentials.md.
COPILOT_GITHUB_TOKEN=

# ---- GitHub agent identity (see github/PROVISIONING.md) --------------------
# Optional for pentesting a local code drop (--target a local path); required
# only if agents clone/fetch target repos or push findings branches. Used as
# the git commit author/committer name (email derived as
# <username>@users.noreply.github.com). Should match the account/bot that owns
# GITHUB_AGENT_TOKEN.
GITHUB_AGENT_USERNAME=your-agent-bot
GITHUB_AGENT_TOKEN=REPLACE_ME
# Comma-separated owner/repo list the agents may clone/fetch — the exact set
# of code-under-test repos for this engagement. Enforced by quota-guard, not
# just informational. Leave empty if you only ever pentest local code drops.
GITHUB_ALLOWED_REPOS=yourorg/target-under-test

# ---- Agent team (see docs/pentest-team.md) ---------------------------------
# Which OpenClaw agent scripts/pentest-task.sh submits to by default when
# --agent is omitted. main (lead pentester) is the default and typically
# delegates to recon/exploit/reporter itself; set --agent on a per-call basis
# to bypass main and target a specialist directly instead.
DEFAULT_TASK_AGENT=main

# ---- Quota / task limits (see docs/quota-protection.md) --------------------
MAX_ITERATIONS_PER_TASK=50
MAX_AI_REQUESTS_PER_TASK=100
MAX_RETRIES_PER_OPERATION=3
MAX_CONCURRENT_TASKS=1
MAX_TASK_RUNTIME=2h
QUOTA_GUARD_FAILURE_THRESHOLD=5
QUOTA_GUARD_FAILURE_WINDOW_SECONDS=60
QUOTA_GUARD_BACKOFF_BASE_SECONDS=10
QUOTA_GUARD_BACKOFF_MAX_SECONDS=3600

# ---- Black-box LIVE testing (see docs/blackbox-live-testing.md) -------------
# Platform kill switch for scoped black-box LIVE testing. Ships OFF: with this
# false, EVERY engagement is read-only/air-gapped (no packets ever leave the box
# for a target), exactly like white-box. Set to true ONLY on a box authorized to
# actively test targets; even then each run must still pass --mode black-box
# --live --scope-file, and the scoped target-gateway stays deny-by-default.
BLACKBOX_LIVE_TESTING=false
# Default per-host request rate (req/s) the target-gateway enforces when the
# requirement spec does not state one. Kept deliberately gentle. A per-host
# "# rate: N" directive in the scope file (from the spec) overrides this.
TARGET_RATE_DEFAULT=5
# Hard cap on concurrent in-flight requests per host.
TARGET_MAX_CONCURRENCY=2
# The effective cap is always (rate * safety factor), to stay comfortably under
# the stated/target limit and avoid being throttled or blocked (0 < factor <= 1).
TARGET_RATE_SAFETY_FACTOR=0.8
# Images for the two profiled black-box-live services (built locally by default).
TARGET_GATEWAY_IMAGE=clawshell/target-gateway:local
PENTEST_TOOLS_MCP_IMAGE=clawshell/pentest-tools-mcp:local

# ---- Caveman token-reduction (see docs/caveman-integration.md) -------------
# Skill only (output tokens, ~65% reduction on prose): safe default, no proxy,
# no new network path. Installed once by scripts/install-caveman-skill.sh.
CAVEMAN_SKILL_ENABLED=true
# Local input-compression proxy (~33% input-token reduction). Off by default.
# Only supports MODEL_PROVIDER=custom (OpenAI-compatible upstream) today —
# see docs/caveman-integration.md before enabling. To enable:
#   1. Set CAVEMAN_UPSTREAM_BASE_URL below to your REAL upstream endpoint
#      (i.e. what MODEL_PROVIDER_BASE_URL currently points at).
#   2. Change MODEL_PROVIDER_BASE_URL (above) to http://127.0.0.1:8787/compat/upstream
#   3. Set CAVEMAN_PROXY_ENABLED=true
#   4. Re-run ./scripts/install.sh (or ./scripts/update.sh) — it reads this
#      var and starts/stops the caveman-proxy container for you.
#   5. Restart openclaw-gateway
CAVEMAN_PROXY_ENABLED=false
CAVEMAN_UPSTREAM_BASE_URL=

# ---- Host hardening toggles -------------------------------------------------
ENABLE_UNATTENDED_UPGRADES=true
UNATTENDED_UPGRADES_AUTO_REBOOT=false
DISK_USAGE_WARN_PERCENT=80

# ---- Backups ----------------------------------------------------------------
BACKUP_RETENTION_DAYS=30

# ---- Auto-managed (do not edit unless you know why) --------------------------
# Set automatically by install.sh from the system `clawshell` user it
# creates, so the openclaw-gateway/openclaw-cli containers run as the exact
# same uid:gid that owns the bind-mounted host directories. Re-running
# install.sh keeps these in sync; only override manually if you know your
# `clawshell` system user's uid/gid differ from what install.sh detected.
AGENT_UID=1000
AGENT_GID=1000
