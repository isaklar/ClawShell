#!/usr/sbin/nft -f
# clawshell nftables ruleset template.
#
# This file is a TEMPLATE. install.sh renders it into /etc/clawshell/nftables.conf
# using SSH_PORT, SSH_ALLOW_CIDR, LAN_ALLOW_CIDR, LAN_ALLOW_CIDR6,
# OPENCLAW_GATEWAY_PORT and FIREWALL_INPUT_POLICY from your .env, prints it, asks
# for confirmation, syntax-checks it (nft -c) and only then loads it. The
# clawshell-firewall.service unit reloads it on boot. Do not `nft -f` this file
# directly with the placeholder tokens still in it.
#
# Everything lives in ONE dedicated table (inet clawshell). It never runs
# `flush ruleset`, so Docker's own iptables-nft rules, firewalld/ufw, libvirt,
# Tailscale etc. are left intact. A drop verdict in this table is final for the
# packet; an accept only means "this table has no objection" and other tables
# still apply. Loading is atomic: `nft -f` applies the whole file or nothing.
#
# See docs/networking.md for the reasoning.

# Idempotent reload: create-if-missing, then delete, then redefine.
table inet clawshell
delete table inet clawshell

table inet clawshell {
    chain input {
        # FIREWALL_INPUT_POLICY: drop (dedicated box, deny-by-default inbound)
        # or accept (shared desktop; only the SSH and gateway ports below are
        # restricted, every other inbound service keeps working).
        type filter hook input priority filter; policy __INPUT_POLICY__;

        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop

        icmp type { echo-request, destination-unreachable, time-exceeded } limit rate 10/second accept
        icmpv6 type { echo-request, nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } limit rate 10/second accept
        # DHCPv6 client replies (link-local server), so IPv6 address leases keep working.
        ip6 saddr fe80::/10 udp dport 546 accept

        # SSH — key-only auth is the real control; this just rate-limits and
        # scopes the source CIDR per .env: SSH_ALLOW_CIDR.
        ip saddr __SSH_ALLOW_CIDR__ tcp dport __SSH_PORT__ ct state new limit rate 15/minute accept
        tcp dport __SSH_PORT__ drop

        # OpenClaw Control UI / Gateway API — LAN only, per .env: LAN_ALLOW_CIDR
        # (and LAN_ALLOW_CIDR6, ::1/128 when unset = no IPv6 LAN access). Only
        # relevant if Docker's userland proxy is enabled; with the default
        # userland-proxy=false, published ports are DNATed and handled by the
        # forward chain below instead.
        ip saddr __LAN_ALLOW_CIDR__ tcp dport __OPENCLAW_GATEWAY_PORT__ accept
        ip6 saddr __LAN_ALLOW_CIDR6__ tcp dport __OPENCLAW_GATEWAY_PORT__ accept
        tcp dport __OPENCLAW_GATEWAY_PORT__ drop

        # Everything else inbound: dropped by policy (drop mode only), logged
        # first for visibility. install.sh removes this line in accept mode.
        log prefix "nft-input-drop: " limit rate 5/minute
    }

    chain forward {
        # Policy accept on purpose: Docker manages container forwarding and
        # NAT in its own tables, and a drop policy here would break every
        # container's egress. This chain only adds restrictions.
        type filter hook forward priority filter - 1; policy accept;

        # Published container ports (Docker DNAT) are reachable only from the
        # LAN, so a `ports:` entry in compose.yml can never be exposed beyond
        # LAN_ALLOW_CIDR. Container egress (no DNAT) is not affected.
        ct state new ct status dnat ip saddr != __LAN_ALLOW_CIDR__ ip saddr != 127.0.0.0/8 counter drop
        ct state new ct status dnat ip6 saddr != __LAN_ALLOW_CIDR6__ ip6 saddr != ::1/128 counter drop
    }
}
